POSTGRES_USER=pipeline
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_DB=commerce
POSTGRES_PORT=5432
AIRFLOW_PORT=8080
LOADER_PASSWORD=replace-with-a-different-local-secret
EXTRACTOR_PASSWORD=replace-with-a-different-local-secret
AIRFLOW_DB_PASSWORD=replace-with-a-different-local-secret
AIRFLOW_ADMIN_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgresql://loader:replace-with-a-different-local-secret@postgres:5432/commerce
SOURCE_DATABASE_URL=postgresql://extractor:replace-with-a-different-local-secret@postgres:5432/commerce
API_BASE_URL=http://mock-api:8000
DATA_ROOT=/opt/pipeline/data
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://pipeline:change-me-locally@postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
